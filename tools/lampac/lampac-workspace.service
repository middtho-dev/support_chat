[Unit]
Description=Lampac workspace management API
After=network.target

[Service]
Type=simple
User=lampac
Group=lampac
EnvironmentFile=/etc/lampac-workspace.env
ExecStart=/usr/bin/python3 /usr/local/lib/lampac-workspace/agent.py
Restart=on-failure
RestartSec=3
UMask=0077
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
