# Change the domain and backend together with DNS and Lampac listen settings.
lc.kv9.ru {
    bind 0.0.0.0
    @management path_regexp tsManagement (?i)^/+ts/+shutdown(/|$)
    route {
        uri path_regexp ^/{2,} /
        respond @management "Use the authenticated workspace to manage TorrServer" 403
        forward_auth 127.0.0.1:7600 {
            uri /access
            header_up X-Admin-Token {$LAMPAC_SERVICE_TOKEN}
            header_up X-Workspace-IP {remote_host}
            header_up X-Workspace-UA {http.request.header.User-Agent}
            header_up X-Workspace-URI {uri}
        }
        handle /workspace-client.js {
            rewrite * /client.js
            reverse_proxy 127.0.0.1:7600 {
                header_up X-Admin-Token {$LAMPAC_SERVICE_TOKEN}
            }
        }
        handle /workspace-device/* {
            @preflight method OPTIONS
            header Access-Control-Allow-Origin "*"
            header Access-Control-Allow-Methods "POST, OPTIONS"
            header Access-Control-Allow-Headers "Content-Type"
            respond @preflight 204
            reverse_proxy 127.0.0.1:7600 {
                header_up X-Admin-Token {$LAMPAC_SERVICE_TOKEN}
                header_up X-Workspace-IP {remote_host}
            }
        }
        handle {
            reverse_proxy 127.0.0.1:9118 {
                header_up X-Real-IP {remote_host}
            }
        }
    }
    encode zstd gzip
    header -Server
}
