# Required: private operator inbox
TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
TELEGRAM_MODE=private
# Comma-separated Telegram user IDs allowed to use the bot and Mini App.
TELEGRAM_ADMIN_IDS=123456789
ADMIN_TOKEN=change-me-to-a-long-random-token

# Optional fallback for migration only:
# TELEGRAM_MODE=legacy
# TELEGRAM_GROUP_ID=-1001234567890

# App
PORT=3001
CORS_ORIGIN=*
PUBLIC_URL=https://support.example.com
# Optional override for Telegram Mini App admin button.
# Defaults to PUBLIC_URL + /miniapp when empty.
TELEGRAM_WEBAPP_URL=

# Optional persistent web push keys.
# If omitted, the app stores generated keys in the Docker data volume.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=support@example.com
